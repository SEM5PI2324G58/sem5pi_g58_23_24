		{
			"name": "CriarTarefaVigilancia",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {\r",
							"    pm.response.to.have.status(201);\r",
							"});\r",
							"\r",
							"pm.test(\"Informação retornada foi a esperada\", function () {\r",
							"    var jsonData = pm.response.json();\r",
							"    pm.environment.set(\"idVigilancia\", jsonData.id);\r",
							"    pm.expect(jsonData).to.eql({\r",
							"    \"tipoTarefa\": \"Vigilancia\",\r",
							"    \"id\": pm.environment.get(\"idVigilancia\"),\r",
							"    \"percursoString\": \"percursoVigilanciaPlaceholder\",\r",
							"    \"estadoString\": \"Pendente\",\r",
							"    \"emailRequisitor\": \"emailPlaceholder\",\r",
							"    \"codDispositivo\": \"\",\r",
							"    \"codConfirmacao\": null,\r",
							"    \"descricaoEntrega\": null,\r",
							"    \"nomePickUp\": null,\r",
							"    \"numeroPickUp\": null,\r",
							"    \"nomeDelivery\": null,\r",
							"    \"numeroDelivery\": null,\r",
							"    \"salaInicial\": null,\r",
							"    \"salaFinal\": null,\r",
							"    \"nomeVigilancia\": \"Cavaco Silva\",\r",
							"    \"numeroVigilancia\": \"987654321\",\r",
							"    \"codEdificio\": \"A\",\r",
							"    \"numeroPiso\": 1\r",
							"    });\r",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
