			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Informação retornada foi a esperada\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.environment.set(\"id\", jsonData.idTipoDispositivo);",
							"    pm.expect(jsonData).to.eql({",
							"    \"idTipoDispositivo\": pm.environment.get(\"id\"),",
							"    \"tipoTarefa\": [",
							"        \"PickUp/Delivery\"",
							"    ],",
							"    \"marca\": \"testeTeste\",",
							"    \"modelo\": \"testeTeste\"",
							"});",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
