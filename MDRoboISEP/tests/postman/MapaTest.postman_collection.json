							"            \"abcissa\": 3,",
							"            \"ordenada\": 2,",
							"            \"orientacao\": \"Norte\"",
							"        }],",
							"        \"elevador\" : {",
							"            \"xCoord\" : 3,",
							"            \"yCoord\" : 3,",
							"            \"orientacao\": \"Norte\"   ",
							"        },",
							"        \"salas\": [{",
							"            \"nome\": \"B300\",",
							"            \"abcissaA\": 0,",
							"            \"ordenadaA\": 0,",
							"            \"abcissaB\": 2,",
							"            \"ordenadaB\": 2,",
							"            \"abcissaPorta\" : 1,",
							"            \"ordenadaPorta\" : 0,",
							"            \"orientacaoPorta\" : \"Norte\"",
